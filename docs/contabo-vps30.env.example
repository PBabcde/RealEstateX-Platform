# Template only. Configure these through Replit's secure environment/secrets flow,
# not by copying private key contents into this file or into source control.
CONTABO_VPS30_HOST=
CONTABO_VPS30_USER=

# Filesystem path to a secret-backed SSH key file; do not put the key itself here.
CONTABO_VPS30_SSH_KEY_FILE=

# Pinned host key entry for the target host. Do not generate or accept this
# dynamically during the release check.
CONTABO_VPS30_KNOWN_HOSTS_FILE=

# Optional; defaults to CONTABO_VPS30_HOST.
CONTABO_VPS30_TLS_HOST=

# Required absolute remote script path. The runner invokes only this script
# with --dry-run and rejects shell syntax in the value.
CONTABO_VPS30_RECOVERY_SCRIPT=/opt/realestatex/bin/recovery-dry-run.sh